#!/usr/bin/env python3
"""Entry point for the fgit CLI."""
import os
import sys

# Make the fgit package importable when this script is run from the bin directory.
ROOT_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT_DIR not in sys.path:
    sys.path.insert(0, ROOT_DIR)

from fgit.cli import main

if __name__ == "__main__":
    sys.exit(main())
